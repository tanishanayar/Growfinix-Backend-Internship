{
  "name": "growfinix-smarthub-backend",
  "version": "1.0.0",
  "description": "Growfinix Internship Month 2 - Real-time chat, Redis caching, background email queue, AI text analysis and advanced product search in one backend.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/workers/emailWorker.js",
    "dev": "concurrently -n API,WORKER -c cyan,magenta \"nodemon src/server.js\" \"nodemon src/workers/emailWorker.js\"",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "setup": "prisma generate && prisma db push && node prisma/seed.js"
  },
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.14",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "prisma": "5.22.0"
  }
}
